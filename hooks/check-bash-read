#!/bin/bash
# PreToolUse Bash hook: block cat/head/tail/less/more on large files, redirect to the bulk-reader skill.
# The whole hook is one Python process (scripts/py/shunt/hooks.py): no jq, no
# other subprocess. It prints the hook JSON and always exits 0, also when the
# interpreter is missing (then the call is allowed / nothing is injected).

case "${BASH_SOURCE[0]}" in
  */*) HOOK_DIR="${BASH_SOURCE[0]%/*}" ;;
  *) HOOK_DIR=. ;;
esac
# shellcheck source=../scripts/lib/py.sh
source "$HOOK_DIR/../scripts/lib/py.sh"

SHUNT_HOOK_PYTHON="${SHUNT_PYTHON:-python3}"
if ! command -v "$SHUNT_HOOK_PYTHON" >/dev/null 2>&1 || [ ! -r "${SHUNT_PY_MAIN:-}" ]; then
  echo "shunt: the Python interpreter is unusable (not found or no entry script), the hook does nothing." >&2
  printf '%s\n' '{"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "allow"}}'
  exit 0
fi

exec "$SHUNT_HOOK_PYTHON" -I -B -S "$SHUNT_PY_MAIN" hook check-bash-read
