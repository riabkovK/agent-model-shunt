#!/bin/bash
# Delegate a read-only question about one or more files to a custom model via
# OpenCode or an HTTP provider. Analogous to shunt's scripts/bulk-read, routed
# through the Python core instead of the Portal CLI.
#
# Usage:
#   bulk-read --question "..." --paths file1 [file2 ...]
#
# The whole call (arguments, failover over the candidate models, the answer, the
# usage line, the debug log) is one process: scripts/py/shunt/bulk_read.py. This
# launcher only starts it, with no other process in between (no dirname, no
# sourced library that spawns one).

case "${BASH_SOURCE[0]}" in
  */*) SCRIPT_DIR="${BASH_SOURCE[0]%/*}" ;;
  *) SCRIPT_DIR=. ;;
esac
# shellcheck source=lib/py.sh
source "$SCRIPT_DIR/lib/py.sh"

exec "${SHUNT_PYTHON:-python3}" -I -B "$SHUNT_PY_MAIN" bulk-read -- "$@"
