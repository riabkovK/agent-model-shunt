#!/bin/bash
# Write side of the shunt-owned circuit breaker config
# (~/.config/agent-model-shunt/breaker-config.json by default). Lets a user
# tune the failure threshold and cooldown, or disable the breaker outright,
# without hand-editing JSON or exporting env vars. Driven by the
# /model-config skill; never hand-edit breaker-config.json directly.
#
# Usage:
#   shunt-breaker-config show
#   shunt-breaker-config set threshold <positive integer>
#   shunt-breaker-config set cooldown <non-negative integer>
#   shunt-breaker-config disable
#   shunt-breaker-config reset

# One process: scripts/py/shunt/breaker_config_cli.py runs every subcommand. This launcher
# only starts it, with no other process in between. The arguments go through raw.

# No child may source a caller's startup file (it could turn on xtrace or log a key).
unset BASH_ENV ENV

case "${BASH_SOURCE[0]}" in
  */*) SCRIPT_DIR="${BASH_SOURCE[0]%/*}" ;;
  *) SCRIPT_DIR=. ;;
esac
# shellcheck source=lib/py.sh
source "$SCRIPT_DIR/lib/py.sh"

exec "${SHUNT_PYTHON:-python3}" -I -B "$SHUNT_PY_MAIN" shunt-breaker-config -- "$@"
