#!/bin/bash
# Write side of the shunt-owned self-fix loop config
# (~/.config/agent-model-shunt/code-write-self-fix-config.json by default).
# Lets a user tune how many times code-write's self-fix loop (orchestrated
# in skills/code-writer/SKILL.md, not in the Python code-write path itself) retries a
# failing generated file before falling back to Claude fixing it by hand,
# without hand-editing JSON or exporting env vars. Driven by the
# /model-config skill; never hand-edit code-write-self-fix-config.json
# directly.
#
# Usage:
#   shunt-codewrite-config show
#   shunt-codewrite-config set self-fix-retries <non-negative integer>
#   shunt-codewrite-config reset

# One process: scripts/py/shunt/codewrite_config_cli.py runs every subcommand. This launcher
# only starts it, with no other process in between. The arguments go through raw.

# No child may source a caller's startup file (it could turn on xtrace or log a key).
unset BASH_ENV ENV

case "${BASH_SOURCE[0]}" in
  */*) SCRIPT_DIR="${BASH_SOURCE[0]%/*}" ;;
  *) SCRIPT_DIR=. ;;
esac
# shellcheck source=lib/py.sh
source "$SCRIPT_DIR/lib/py.sh"

exec "${SHUNT_PYTHON:-python3}" -I -B "$SHUNT_PY_MAIN" shunt-codewrite-config -- "$@"
