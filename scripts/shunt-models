#!/bin/bash
# Write side of the shunt-owned delegate model registry
# (~/.config/agent-model-shunt/models.json). Adds/removes/reorders models,
# picks the active one, and materializes each model's OpenCode agent file
# once at edit time. Driven by the /model-config skill; never hand-edit
# models.json directly.
#
# Usage:
#   shunt-models list
#   shunt-models status
#   shunt-models dashboard   (everything /model-config shows, one call, see lib/dashboard.sh)
#   shunt-models add <provider/model> [<role>[,<role>...]]
#   shunt-models remove <provider/model>
#   shunt-models reorder <provider/model> <1-based position>
#   shunt-models activate <provider/model>
#   shunt-models thinking <provider/model> <on|off> [options-json]
#     on: options-json holds the provider's reasoning options (flat object).
#     off: options-json (a flat object) sets explicit off options, e.g.
#          '{"reasoningEffort":"none"}', rendered into the agent files while
#          thinking is off. Omitted: stored off options stay. '{}' clears them.
#   shunt-models request-body <provider/model> [--role <bulk-read|code-write>] <json-object|--clear>
#     Sets or clears the model's request_body (extra fields of every HTTP request),
#     or with --role only that role's role_request_body entry, merged on top of it.
#   shunt-models roles <provider/model> <role>[,<role>...]
#   shunt-models set-context <provider/model> <tokens>
#   shunt-models detect-context <provider/model> [--write]
#     Asks the provider for the context window (never guessed). --write stores it.
#   shunt-models oversize-policy <provider/model> <map_reduce|fail|--clear>
#     set-context, detect-context --write and oversize-policy reset the model's breaker.
#   shunt-models sync
#   shunt-models provider set <name> [--transport http|opencode] [--base-url <url>]
#                [--key keyring|plaintext|none|env:<VARNAME>]
#     Creates or updates a providers.json entry, keeping fields not given. Never
#     takes a key value: store it with `key set`.
#   shunt-models provider list           (name, transport, base_url, key type)
#   shunt-models key set <provider>      (hidden prompt, or one line on piped stdin)
#   shunt-models key status <provider>   (yes/no and key type, never the value)
#   shunt-models --migrate-from-opencode [--apply [--yes]] [--key-storage keyring|env|plaintext|skip]
#     Moves the registry's providers from the OpenCode config to the HTTP transport.
#     Dry run by default (prints the plan). --apply backs up models.json and
#     providers.json, then writes. Without a tty --apply needs --yes (the
#     caller confirms the dry-run plan first); --yes skips the y/N prompt. A literal apiKey is copied only to the chosen
#     storage and never shown.

# A BASH_ENV startup file may have turned xtrace on, which would print a key read below.
set +x
# No child may source a caller's startup file (it could turn on xtrace or log a key).
unset BASH_ENV ENV
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/opencode.sh
source "$SCRIPT_DIR/lib/opencode.sh"
# shellcheck source=lib/models.sh
source "$SCRIPT_DIR/lib/models.sh"
# shellcheck source=lib/providers.sh
source "$SCRIPT_DIR/lib/providers.sh"
# shellcheck source=lib/context-detect.sh
source "$SCRIPT_DIR/lib/context-detect.sh"
# shellcheck source=lib/migrate.sh
source "$SCRIPT_DIR/lib/migrate.sh"
# shellcheck source=lib/selffix.sh
source "$SCRIPT_DIR/lib/selffix.sh"
# shellcheck source=lib/dashboard.sh
source "$SCRIPT_DIR/lib/dashboard.sh"

# shunt_models_unavailable_notice
# Explains why the registry is not in use: absent (legacy single-agent mode)
# or present but invalid, in which case the validation reason is shown so a
# typo in a hand-edit is not mistaken for legacy mode.
shunt_models_unavailable_notice() {
  if [ -f "$SHUNT_MODELS_FILE" ]; then
    echo "$(shunt_models_validate) Delegate calls use the legacy single agent until it is fixed."
  else
    echo "shunt: no models registry at $SHUNT_MODELS_FILE (legacy single-agent mode)."
  fi
}

# _shunt_models_write_py <subcommand> [args...]
# Runs a models-write subcommand (scripts/py/shunt/models_write.py) on the
# registry file this script resolved. A failure has already printed its
# `shunt:` line, so the script exits with the same status, like
# shunt_report_error did.
_shunt_models_write_py() {
  local rc=0
  SHUNT_MODELS_FILE="$SHUNT_MODELS_FILE" shunt_py models-write "$@" || rc=$?
  [ "$rc" -eq 0 ] || exit "$rc"
}

# shunt_models_parse_roles <role>[,<role>...]
# Prints the roles as a comma separated line, order kept and duplicates dropped.
# Exits with an error on an empty, unknown or multi-line list.
shunt_models_parse_roles() {
  local out
  out=$(_shunt_models_write_py parse-roles -- "$1") || exit "$?"
  printf '%s\n' "$out"
}

# cmd_add <id> [<role>[,<role>...]]
# Roles default to all of them, written explicitly so the registry shows what
# the model may do. Roles are validated before anything is written.
cmd_add() {
  local id="${1:-}" roles_arg="${2:-}"
  [ -n "$id" ] || shunt_report_error "usage: shunt-models add <provider/model> [<role>[,<role>...]] (roles: ${SHUNT_MODELS_ROLES[*]})"

  local roles_csv="${SHUNT_MODELS_ROLES[*]}"
  roles_csv="${roles_csv// /,}"
  if [ -n "$roles_arg" ]; then
    roles_csv=$(shunt_models_parse_roles "$roles_arg")
  fi

  # An http provider from providers.json needs nothing from opencode.json (add
  # only checks that the provider exists). Any other provider is called through
  # OpenCode, so it must be in opencode.json.
  local provider="${id%%/*}" transport
  transport=$(shunt_provider_transport "$provider") || exit 1
  local opencode_json="$SHUNT_OPENCODE_CONFIG_HOME/opencode.json"
  if [ "$transport" != http ] \
    && { [ ! -f "$opencode_json" ] || ! jq -e --arg p "$provider" '.provider[$p]' "$opencode_json" >/dev/null 2>&1; }; then
    shunt_report_error "provider '$provider' not found in $opencode_json. Add it to your OpenCode config first, or configure it for the HTTP transport with: shunt-models provider set $provider --transport http --base-url <url> --key <type>"
  fi

  shunt_models_require_prompts ${roles_csv//,/ }

  # Refuses a duplicate id, writes, and prints the agent name it derived.
  local slug
  slug=$(_shunt_models_write_py add -- "$id" "$roles_csv") || exit "$?"
  shunt_models_materialize_agent "$id"
  echo "shunt: added '$id' (agent: $slug, roles: $roles_csv)."
}

cmd_remove() {
  local id="${1:-}"
  [ -n "$id" ] || shunt_report_error "usage: shunt-models remove <provider/model>"
  shunt_models_available || shunt_report_error "no models registry at $SHUNT_MODELS_FILE."

  shunt_models_require_entry "$id"

  local agent writer
  agent=$(shunt_models_agent_for "$id")
  writer=$(shunt_models_code_writer_agent_for "$id")

  _shunt_models_write_py remove -- "$id"

  # Registry write succeeded; now drop the model's leftovers so nothing stale
  # survives (its materialized agent files and its circuit breaker state).
  [ -z "$agent" ] || rm -f "$SHUNT_AGENTS_DIR/$agent.md"
  rm -f "$SHUNT_AGENTS_DIR/$writer.md"
  shunt_breaker_clear_state "$id"
  echo "shunt: removed '$id'."
}

cmd_reorder() {
  local id="${1:-}" position="${2:-}"
  [ -n "$id" ] && [ -n "$position" ] || shunt_report_error "usage: shunt-models reorder <provider/model> <1-based position>"
  case "$position" in ''|*[!0-9]*) shunt_report_error "position must be a positive integer." ;; esac
  shunt_models_available || shunt_report_error "no models registry at $SHUNT_MODELS_FILE."

  shunt_models_require_entry "$id"

  _shunt_models_write_py reorder -- "$id" "$position"
  echo "shunt: moved '$id' to position $position."
}

cmd_activate() {
  local id="${1:-}"
  [ -n "$id" ] || shunt_report_error "usage: shunt-models activate <provider/model>"
  shunt_models_available || shunt_report_error "no models registry at $SHUNT_MODELS_FILE."

  shunt_models_require_entry "$id"

  # Python refuses a disabled model before it writes.
  _shunt_models_write_py activate -- "$id"
  echo "shunt: activated '$id'."
}

# cmd_set_enabled <true|false> <id>
# Backs `enable`/`disable`. Only flips the flag: the model keeps its
# position, agent file and active marker, so re-enabling restores it as-is.
cmd_set_enabled() {
  local value="$1" id="${2:-}"
  local verb="enable"
  [ "$value" = "true" ] || verb="disable"
  [ -n "$id" ] || shunt_report_error "usage: shunt-models $verb <provider/model>"
  shunt_models_available || shunt_report_error "no models registry at $SHUNT_MODELS_FILE."

  shunt_models_require_entry "$id"

  _shunt_models_write_py set-enabled -- "$value" "$id"
  echo "shunt: ${verb}d '$id'."
}

cmd_thinking() {
  local id="${1:-}" state="${2:-}" options="${3:-}"
  [ -n "$id" ] && [ -n "$state" ] || shunt_report_error "usage: shunt-models thinking <provider/model> <on|off> [options-json]"
  case "$state" in
    on|off) ;;
    *) shunt_report_error "thinking state must be 'on' or 'off'." ;;
  esac
  shunt_models_available || shunt_report_error "no models registry at $SHUNT_MODELS_FILE."

  shunt_models_require_entry "$id"

  # Python validates the options and writes. Without options-json the stored
  # off options stay as they are, an empty object clears them, and `on` never
  # touches them.
  _shunt_models_write_py thinking -- "$id" "$state" "$options"
  shunt_models_materialize_agent "$id"
  echo "shunt: thinking for '$id' set to $state."
}

# cmd_request_body <id> [--role <role>] <json-object|--clear>
# Sets or clears request_body, or role_request_body[<role>] with --role. An
# emptied role_request_body is dropped from the entry.
cmd_request_body() {
  local id="${1:-}" role="" value
  local usage="usage: shunt-models request-body <provider/model> [--role <${SHUNT_MODELS_ROLES[0]}|${SHUNT_MODELS_ROLES[1]}>] <json-object|--clear>"
  [ -n "$id" ] || shunt_report_error "$usage"
  shift
  if [ "${1:-}" = "--role" ]; then
    role="${2:-}"
    [ -n "$role" ] || shunt_report_error "$usage"
    shift 2
  fi
  value="${1:-}"
  [ -n "$value" ] && [ "$#" -eq 1 ] || shunt_report_error "$usage"
  if [ -n "$role" ]; then
    printf '%s\n' "${SHUNT_MODELS_ROLES[@]}" | grep -qxF -- "$role" \
      || shunt_report_error "unknown role '$role' (roles: ${SHUNT_MODELS_ROLES[*]})."
  fi
  # Checked here, before the registry is looked at, so the error order is unchanged.
  if [ "$value" != "--clear" ]; then
    echo "$value" | jq -e 'type == "object"' >/dev/null 2>&1 \
      || shunt_report_error "request body must be a JSON object: $value"
  fi
  shunt_models_available || shunt_report_error "no models registry at $SHUNT_MODELS_FILE."
  shunt_models_require_entry "$id"
  local outcome
  outcome=$(_shunt_models_write_py request-body -- "$id" "$role" "$value") || exit "$?"
  echo "shunt: request body for '$id'${role:+ (role $role)} $outcome."
}

# cmd_roles <id> <role>[,<role>...]
# Sets the model's `roles` (bulk-read, code-write). Order is kept and
# duplicates dropped. Rewrites the registry, then re-materializes the model's
# agent files so its code-writer agent exists exactly while it has the
# code-write role.
cmd_roles() {
  local id="${1:-}" roles_arg="${2:-}"
  [ -n "$id" ] && [ -n "$roles_arg" ] || shunt_report_error "usage: shunt-models roles <provider/model> <role>[,<role>...] (roles: ${SHUNT_MODELS_ROLES[*]})"

  local roles_csv
  roles_csv=$(shunt_models_parse_roles "$roles_arg")

  # Deliberately not shunt_models_available: this command is the way to fix a
  # registry that is invalid only because of a bad `roles` value.
  shunt_models_require_entry "$id"

  shunt_models_require_prompts ${roles_csv//,/ }

  _shunt_models_write_py roles -- "$id" "$roles_csv"
  shunt_models_materialize_agent "$id"
  echo "shunt: roles for '$id' set to $roles_csv."

  local problem
  problem=$(shunt_models_validate) || echo "shunt: warning, the registry is still invalid: $problem" >&2
}

# Longest context_tokens accepted, in digits (keeps the value exact in jq).
SHUNT_CONTEXT_MAX_DIGITS=12

# shunt_models_store_context <provider/model> <tokens>
# Stores <tokens> as the model's context_tokens through the atomic registry
# write. Like cmd_roles it does not need a valid registry to begin with.
shunt_models_store_context() {
  local id="$1" tokens="$2"
  [[ "$tokens" =~ ^[1-9][0-9]{0,$((SHUNT_CONTEXT_MAX_DIGITS - 1))}$ ]] \
    || shunt_report_error "tokens must be a positive integer of at most $SHUNT_CONTEXT_MAX_DIGITS digits."
  shunt_models_require_entry "$id"
  _shunt_models_write_py set-context -- "$id" "$tokens"
  # A missing context window was recorded as a model failure, start clean.
  shunt_breaker_clear_state "$id" || echo "shunt: warning, could not reset the breaker state of '$id'." >&2
  echo "shunt: context_tokens for '$id' set to $tokens."
}

# shunt_models_require_entry <provider/model>
# Exits with an error unless the registry file exists, has a models array and
# holds <id>. Does not need an otherwise valid registry.
shunt_models_require_entry() {
  local id="$1"
  [ -f "$SHUNT_MODELS_FILE" ] || shunt_report_error "no models registry at $SHUNT_MODELS_FILE."
  jq -e '.models | type == "array"' "$SHUNT_MODELS_FILE" >/dev/null 2>&1 \
    || shunt_report_error "$SHUNT_MODELS_FILE is not a valid models registry."
  jq -e --arg id "$id" '.models | any(.id == $id)' "$SHUNT_MODELS_FILE" >/dev/null \
    || shunt_report_error "model '$id' is not in the registry."
}

# set-context <provider/model> <tokens>
cmd_set_context() {
  local id="${1:-}" tokens="${2:-}"
  [ -n "$id" ] && [ -n "$tokens" ] || shunt_report_error "usage: shunt-models set-context <provider/model> <tokens>"
  shunt_models_store_context "$id" "$tokens"
}

# detect-context <provider/model> [--write]
# Asks the provider for the model's context window. Prints it, and with --write
# stores it. Nothing is ever written when the provider does not report one.
cmd_detect_context() {
  local id="${1:-}" write="${2:-}" tokens rc=0
  [ -n "$id" ] && { [ -z "$write" ] || [ "$write" = --write ]; } \
    || shunt_report_error "usage: shunt-models detect-context <provider/model> [--write]"
  shunt_models_require_entry "$id"
  tokens=$(shunt_models_detect_context "$id") || rc=$?
  if [ "$rc" -eq "$SHUNT_DETECT_AUTH_FAILED" ]; then
    echo "shunt: auth failed for the provider of '$id' (the key was rejected with 401 or 403): re-enter the key through /model-config." >&2
    exit "$SHUNT_DETECT_AUTH_FAILED"
  fi
  [ "$rc" -eq 0 ] || tokens=""
  [ -n "$tokens" ] || shunt_report_error "could not detect the context window of '$id' from its provider. Enter it yourself: shunt-models set-context $id <tokens>"
  if [ "$write" = --write ]; then
    shunt_models_store_context "$id" "$tokens"
  fi
  echo "$tokens"
}

# oversize-policy <provider/model> <map_reduce|fail|--clear>
# Sets or clears the model's oversize_policy (absent means map_reduce).
cmd_oversize_policy() {
  local id="${1:-}" policy="${2:-}"
  case "$policy" in
    map_reduce | fail | --clear) ;;
    *) shunt_report_error "usage: shunt-models oversize-policy <provider/model> <map_reduce|fail|--clear>" ;;
  esac
  [ -n "$id" ] || shunt_report_error "usage: shunt-models oversize-policy <provider/model> <map_reduce|fail|--clear>"
  shunt_models_require_entry "$id"
  _shunt_models_write_py oversize-policy -- "$id" "$policy"
  # An oversize failure under the old policy counted against the model.
  shunt_breaker_clear_state "$id" || echo "shunt: warning, could not reset the breaker state of '$id'." >&2
  if [ "$policy" = --clear ]; then
    echo "shunt: oversize_policy for '$id' cleared (map_reduce applies)."
  else
    echo "shunt: oversize_policy for '$id' set to $policy."
  fi
}

# shunt_parse_key_spec <keyring|plaintext|none|env:VARNAME>
# Sets _shunt_key_type and _shunt_key_ref. Never echoes the spec back, so a
# key pasted by mistake does not end up in the output.
shunt_parse_key_spec() {
  _shunt_key_type="" _shunt_key_ref=""
  case "$1" in
    keyring | plaintext | none) _shunt_key_type="$1" ;;
    env:*)
      [[ "${1#env:}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] \
        || shunt_report_error "--key env:<VARNAME> needs a valid environment variable name."
      _shunt_key_type=env _shunt_key_ref="${1#env:}" ;;
    *) shunt_report_error "--key must be keyring, plaintext, none or env:<VARNAME>. Never pass a key value here, store it with: ! $SHUNT_MODELS_HINT_CMD key set <provider>" ;;
  esac
}

_SHUNT_PROVIDER_SET_USAGE="usage: shunt-models provider set <name> [--transport http|opencode] [--base-url <url>] [--key keyring|plaintext|none|env:<VARNAME>]"

# Parses and checks the options of `provider set` (everything after <name>).
# Assigns transport, base_url and, through shunt_parse_key_spec, the key
# variables of cmd_provider_set (bash dynamic scope). Exits with an error on
# bad input.
_shunt_provider_set_parse() {
  while [ $# -gt 0 ]; do
    [ $# -ge 2 ] || shunt_report_error "$_SHUNT_PROVIDER_SET_USAGE"
    case "$1" in
      --transport | --base-url | --key)
        [ -n "$2" ] || shunt_report_error "$1 needs a non-empty value." ;;
    esac
    case "$1" in
      --transport) transport="$2" ;;
      --base-url) base_url="$2" ;;
      --key) shunt_parse_key_spec "$2" ;;
      *) shunt_report_error "$_SHUNT_PROVIDER_SET_USAGE" ;;
    esac
    shift 2
  done
  if [ -n "$transport" ] && ! shunt_word_in_list "$transport" "$SHUNT_PROVIDER_TRANSPORTS"; then
    shunt_report_error "--transport must be one of: $SHUNT_PROVIDER_TRANSPORTS."
  fi
  if [ -n "$base_url" ]; then
    local url_rc=0
    shunt_base_url_check "$base_url" || url_rc=$?
    case "$url_rc" in
      0) ;;
      2 | 3) shunt_report_error "--base-url must start with http:// or https://." ;;
      *) shunt_report_error "--base-url is malformed: it needs a host and must not contain user:password@, whitespace or control characters." ;;
    esac
  fi
}

# Writes the entry for <name> under the providers lock. transport, base_url and
# the key variables are those set by _shunt_provider_set_parse.
_shunt_provider_set_write() {
  local name="$1" summary
  # Python takes the providers lock, validates the file, builds the entry,
  # writes it and prints the summary of what was saved.
  summary=$(_shunt_providers_write_py set -- "$name" "$transport" "$base_url" "$_shunt_key_type" "$_shunt_key_ref") || exit "$?"
  echo "shunt: provider '$name' saved ($summary)."
  case "$_shunt_key_type" in
    keyring | plaintext) echo "shunt: enter the key through /model-config (it opens a password window), or without a desktop: ! $SHUNT_MODELS_HINT_CMD key set $name. Never paste it into chat." ;;
  esac
}

# provider set <name> [--transport http|opencode] [--base-url <url>] [--key <spec>]
# Creates or updates a providers.json entry. Fields not given are kept. A key
# type change drops the stored ref unless it stays plaintext.
cmd_provider_set() {
  local name="${1:-}" transport="" base_url="" _shunt_key_type="" _shunt_key_ref=""
  shunt_provider_name_ok "$name" || shunt_report_error "$_SHUNT_PROVIDER_SET_USAGE"
  shift
  _shunt_provider_set_parse "$@"
  _shunt_provider_set_write "$name"
}

# provider list: name, transport, base_url and key type. Only env refs (a
# variable name) are shown, never a stored key.
# An invalid entry is listed as "invalid: <reason>" and the command exits 1
# after listing the others.
cmd_provider_list() {
  if [ ! -f "$SHUNT_PROVIDERS_FILE" ]; then
    echo "shunt: no providers configured in $SHUNT_PROVIDERS_FILE."
    return 0
  fi
  jq -e '(.providers | type) == "object"' "$SHUNT_PROVIDERS_FILE" >/dev/null 2>&1 \
    || shunt_report_error "$SHUNT_PROVIDERS_FILE is invalid JSON or has no \"providers\" object."
  if jq -e '.providers | length == 0' "$SHUNT_PROVIDERS_FILE" >/dev/null; then
    echo "shunt: no providers configured in $SHUNT_PROVIDERS_FILE."
    return 0
  fi
  shunt_providers_list_lines
  shunt_providers_validate 2>/dev/null \
    || shunt_report_error "$SHUNT_PROVIDERS_FILE has invalid entries (marked above). Fix them before using those providers."
}

# cmd_provider set|list
cmd_provider() {
  local action="${1:-}"
  shift || true
  case "$action" in
    set) cmd_provider_set "$@" ;;
    list) cmd_provider_list ;;
    *) shunt_report_error "usage: shunt-models provider <set|list> [args...]" ;;
  esac
}

cmd_list() {
  shunt_models_available || { shunt_models_unavailable_notice; return 0; }
  local active
  active=$(jq -r '.active // empty' "$SHUNT_MODELS_FILE")
  jq -r '.models[].id' "$SHUNT_MODELS_FILE" | while IFS= read -r id; do
    if [ "$id" = "$active" ]; then
      echo "$id (active)"
    else
      echo "$id"
    fi
  done
}

cmd_status() {
  shunt_models_available || { shunt_models_unavailable_notice; return 0; }
  if [ "$(jq '.models | length' "$SHUNT_MODELS_FILE")" -eq 0 ]; then
    echo "shunt: no delegate models configured (large reads are not redirected)."
    return 0
  fi
  jq -r --argjson all_roles "$SHUNT_MODELS_ROLES_JSON" '
    .active as $active
    | .models[]
    | "\(.id)\t\(.agent)\t" + (if .enabled == false then "disabled" else "enabled" end)
      + "\tthinking=\(.thinking)\tthinking_off=\(if .thinking_off_options == null then "none" else "set" end)\troles=\((.roles // $all_roles) | join(","))\t"
      + (if .id != $active then ""
         elif .enabled == false then "active (skipped, disabled)"
         else "active" end)
  ' "$SHUNT_MODELS_FILE"

  # Which model the next bulk-read call tries first: the active one if it is
  # enabled and has the role, otherwise the first such model in registry order.
  local candidates first
  candidates=$(shunt_models_candidates bulk-read)
  first="${candidates%%$'\n'*}"
  if [ -n "$first" ]; then
    echo "shunt: first choice: $first"
  elif jq -e '.models | any(.enabled != false)' "$SHUNT_MODELS_FILE" >/dev/null; then
    echo "shunt: no enabled model has the bulk-read role (large reads are not redirected)."
  else
    echo "shunt: no enabled models (large reads are not redirected)."
  fi

  # The same for code-write, which uses the same order over the models that
  # have that role. Quiet: the lookup above already warned about an unknown
  # active model.
  candidates=$(shunt_models_candidates code-write quiet)
  first="${candidates%%$'\n'*}"
  if [ -n "$first" ]; then
    echo "shunt: code-write first choice: $first"
  else
    echo "shunt: no enabled model has the code-write role (code-write is unavailable)."
  fi

  # code-write keeps its own failure counter per model, apart from bulk-read's.
  local id
  jq -r --argjson all_roles "$SHUNT_MODELS_ROLES_JSON" \
    '.models[] | select((.roles // $all_roles) | index("code-write") != null) | .id' \
    "$SHUNT_MODELS_FILE" | while IFS= read -r id; do
    echo "shunt: code-write breaker $id: $(shunt_breaker_status "$(shunt_breaker_key "$id" code-write)")"
  done
}

cmd_sync() {
  shunt_models_available || shunt_report_error "no models registry at $SHUNT_MODELS_FILE."
  jq -r '.models[].id' "$SHUNT_MODELS_FILE" | while IFS= read -r id; do
    shunt_models_materialize_agent "$id"
    echo "shunt: re-materialized '$id'."
  done
}

# shunt_read_key
# Prints one key line read from the tty without echo (prompt on stderr), or
# from stdin when it is not a tty (tests, pipes).
shunt_read_key() {
  local key
  if [ -t 0 ]; then
    IFS= read -r -s -p "API key (input hidden): " key
    echo >&2
  else
    IFS= read -r key || true
  fi
  printf '%s\n' "$key"
}

# cmd_key set|status <provider>
cmd_key() {
  local action="${1:-}" provider="${2:-}"
  [ -n "$provider" ] || shunt_report_error "usage: shunt-models key <set|status> <provider>"
  shunt_provider_name_ok "$provider" || { shunt_provider_name_refuse "$provider"; exit 1; }
  [ -f "$SHUNT_PROVIDERS_FILE" ] && jq -e --arg p "$provider" '.providers[$p]' "$SHUNT_PROVIDERS_FILE" >/dev/null 2>&1 \
    || shunt_report_error "provider '$provider' is not in $SHUNT_PROVIDERS_FILE."
  local type
  type=$(shunt_provider_key_type "$provider") || exit 1
  case "$action" in
    set) cmd_key_set "$provider" "$type" ;;
    status)
      if [ "$type" = none ]; then
        echo "shunt: provider '$provider': yes (type none, no key needed)"
      elif shunt_provider_key_resolve "$provider" >/dev/null 2>&1; then
        echo "shunt: provider '$provider': yes (type $type)"
      else
        echo "shunt: provider '$provider': no (type $type)"
      fi ;;
    *) shunt_report_error "usage: shunt-models key <set|status> <provider>" ;;
  esac
}

cmd_key_set() {
  local provider="$1" type="$2" key
  case "$type" in
    env) shunt_report_error "provider '$provider' uses an env key: export the variable named in its key.ref instead." ;;
    none) shunt_report_error "provider '$provider' has key type none, there is no key to set." ;;
    keyring) [ -n "$(shunt_keyring_backend)" ] || shunt_report_error "no keyring backend found (secret-tool, security, kwallet-query). Use an env key type instead." ;;
  esac
  key=$(shunt_read_key)
  [ -n "$key" ] || shunt_report_error "empty key, nothing stored."
  if [ "$type" = keyring ]; then
    printf '%s\n' "$key" | shunt_keyring_store "$provider" || exit 1
  else
    printf '%s\n' "$key" | shunt_provider_plaintext_store "$provider" || exit 1
    shunt_provider_plaintext_warning >&2
  fi
  echo "shunt: key stored for '$provider' (type $type)."
}

subcommand="${1:-}"
[ -n "$subcommand" ] || shunt_report_error "usage: shunt-models <list|status|dashboard|add|remove|reorder|activate|enable|disable|thinking|request-body|roles|set-context|detect-context|oversize-policy|sync|provider|key|--migrate-from-opencode> [args...]"
shift

case "$subcommand" in
  add) cmd_add "$@" ;;
  remove) cmd_remove "$@" ;;
  reorder) cmd_reorder "$@" ;;
  activate) cmd_activate "$@" ;;
  enable) cmd_set_enabled true "$@" ;;
  disable) cmd_set_enabled false "$@" ;;
  thinking) cmd_thinking "$@" ;;
  request-body) cmd_request_body "$@" ;;
  roles) cmd_roles "$@" ;;
  set-context) cmd_set_context "$@" ;;
  detect-context) cmd_detect_context "$@" ;;
  oversize-policy) cmd_oversize_policy "$@" ;;
  provider) cmd_provider "$@" ;;
  list) cmd_list "$@" ;;
  status) cmd_status "$@" ;;
  dashboard) cmd_dashboard "$@" ;;
  sync) cmd_sync "$@" ;;
  key) cmd_key "$@" ;;
  --migrate-from-opencode) cmd_migrate_from_opencode "$@" ;;
  *) shunt_report_error "unknown subcommand: $subcommand" ;;
esac
