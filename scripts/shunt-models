#!/bin/bash
# Write side of the shunt-owned delegate model registry
# (~/.config/agent-model-shunt/models.json). Adds/removes/reorders models,
# picks the active one, and materializes each model's OpenCode agent file
# once at edit time. Driven by the /model-config skill; never hand-edit
# models.json directly.
#
# Usage:
#   shunt-models list
#   shunt-models status
#   shunt-models add <provider/model> [<role>[,<role>...]]
#   shunt-models remove <provider/model>
#   shunt-models reorder <provider/model> <1-based position>
#   shunt-models activate <provider/model>
#   shunt-models thinking <provider/model> <on|off> [options-json]
#     on: options-json holds the provider's reasoning options (flat object).
#     off: options-json (a flat object) sets explicit off options, e.g.
#          '{"reasoningEffort":"none"}', rendered into the agent files while
#          thinking is off. Omitted: stored off options stay. '{}' clears them.
#   shunt-models request-body <provider/model> [--role <bulk-read|code-write>] <json-object|--clear>
#     Sets or clears the model's request_body (extra fields of every HTTP request),
#     or with --role only that role's role_request_body entry, merged on top of it.
#   shunt-models roles <provider/model> <role>[,<role>...]
#   shunt-models set-context <provider/model> <tokens>
#   shunt-models detect-context <provider/model> [--write]
#     Asks the provider for the context window (never guessed). --write stores it.
#   shunt-models sync
#   shunt-models key set <provider>      (hidden prompt, or one line on piped stdin)
#   shunt-models key status <provider>   (yes/no and key type, never the value)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/opencode.sh
source "$SCRIPT_DIR/lib/opencode.sh"
# shellcheck source=lib/models.sh
source "$SCRIPT_DIR/lib/models.sh"
# shellcheck source=lib/providers.sh
source "$SCRIPT_DIR/lib/providers.sh"
# shellcheck source=lib/context-detect.sh
source "$SCRIPT_DIR/lib/context-detect.sh"

# shunt_models_read_or_empty
# Prints the current registry JSON, or an empty-but-valid-shaped registry
# if the file doesn't exist yet.
shunt_models_read_or_empty() {
  if [ -f "$SHUNT_MODELS_FILE" ]; then
    cat "$SHUNT_MODELS_FILE"
  else
    echo '{"version":1,"active":null,"models":[]}'
  fi
}

# shunt_models_unavailable_notice
# Explains why the registry is not in use: absent (legacy single-agent mode)
# or present but invalid, in which case the validation reason is shown so a
# typo in a hand-edit is not mistaken for legacy mode.
shunt_models_unavailable_notice() {
  if [ -f "$SHUNT_MODELS_FILE" ]; then
    echo "$(shunt_models_validate) Delegate calls use the legacy single agent until it is fixed."
  else
    echo "shunt: no models registry at $SHUNT_MODELS_FILE (legacy single-agent mode)."
  fi
}

# shunt_models_write <json>
# Validates <json> and atomically replaces the registry file with it.
# Never leaves a corrupt file behind: writes to a temp file in the same
# directory, validates that, then moves it into place.
shunt_models_write() {
  local json="$1"
  mkdir -p "$(dirname "$SHUNT_MODELS_FILE")"

  local tmp_file
  tmp_file=$(mktemp "$(dirname "$SHUNT_MODELS_FILE")/.models.json.XXXXXX")
  echo "$json" | jq -e . >"$tmp_file" 2>/dev/null \
    || { rm -f "$tmp_file"; shunt_report_error "refusing to write an invalid models registry."; }

  mv "$tmp_file" "$SHUNT_MODELS_FILE"
}

# shunt_models_parse_roles <role>[,<role>...]
# Prints the roles as a compact JSON array, order kept and duplicates dropped.
# Exits with an error on an empty, unknown or multi-line list.
shunt_models_parse_roles() {
  local roles_arg="$1"

  case "$roles_arg" in
    *$'\n'*) shunt_report_error "roles must be a single comma-separated line." ;;
  esac

  local role roles_json="[]"
  local -a parsed
  # read drops one trailing empty field, so append a comma to make a stray
  # trailing comma show up as an empty role and get refused.
  IFS=',' read -r -a parsed <<<"$roles_arg,"
  for role in "${parsed[@]}"; do
    [ -n "$role" ] || shunt_report_error "empty role in '$roles_arg'. Roles: ${SHUNT_MODELS_ROLES[*]}"
    shunt_models_role_known "$role" || shunt_report_error "unknown role '$role'. Known roles: ${SHUNT_MODELS_ROLES[*]}"
    roles_json=$(echo "$roles_json" | jq -c --arg r "$role" 'if index($r) then . else . + [$r] end')
  done
  echo "$roles_json"
}

# cmd_add <id> [<role>[,<role>...]]
# Roles default to all of them, written explicitly so the registry shows what
# the model may do. Roles are validated before anything is written.
cmd_add() {
  local id="${1:-}" roles_arg="${2:-}"
  [ -n "$id" ] || shunt_report_error "usage: shunt-models add <provider/model> [<role>[,<role>...]] (roles: ${SHUNT_MODELS_ROLES[*]})"

  local roles_json="$SHUNT_MODELS_ROLES_JSON"
  if [ -n "$roles_arg" ]; then
    roles_json=$(shunt_models_parse_roles "$roles_arg")
  fi

  local provider="${id%%/*}"
  local opencode_json="$SHUNT_OPENCODE_CONFIG_HOME/opencode.json"
  if [ ! -f "$opencode_json" ] || ! jq -e --arg p "$provider" '.provider[$p]' "$opencode_json" >/dev/null 2>&1; then
    shunt_report_error "provider '$provider' not found in $opencode_json. Add it to your OpenCode config first."
  fi

  local current
  current=$(shunt_models_read_or_empty)

  if echo "$current" | jq -e --arg id "$id" '.models | any(.id == $id)' >/dev/null; then
    shunt_report_error "model '$id' is already in the registry."
  fi

  local slug
  slug=$(shunt_models_slug "$id")

  local updated
  updated=$(echo "$current" | jq --arg id "$id" --arg agent "$slug" --argjson roles "$roles_json" \
    '.models += [{id: $id, agent: $agent, enabled: true, thinking: false, thinking_options: null, thinking_off_options: null, roles: $roles}]')

  shunt_models_write "$updated"
  shunt_models_materialize_agent "$id"
  echo "shunt: added '$id' (agent: $slug, roles: $(echo "$roles_json" | jq -r 'join(",")'))."
}

cmd_remove() {
  local id="${1:-}"
  [ -n "$id" ] || shunt_report_error "usage: shunt-models remove <provider/model>"
  shunt_models_available || shunt_report_error "no models registry at $SHUNT_MODELS_FILE."

  local current
  current=$(cat "$SHUNT_MODELS_FILE")

  if ! echo "$current" | jq -e --arg id "$id" '.models | any(.id == $id)' >/dev/null; then
    shunt_report_error "model '$id' is not in the registry."
  fi

  local agent writer
  agent=$(shunt_models_agent_for "$id")
  writer=$(shunt_models_code_writer_agent_for "$id")

  local updated
  updated=$(echo "$current" | jq --arg id "$id" '
    .models |= map(select(.id != $id))
    | if .active == $id then .active = null else . end
  ')

  shunt_models_write "$updated"

  # Registry write succeeded; now drop the model's leftovers so nothing stale
  # survives (its materialized agent files and its circuit breaker state).
  [ -z "$agent" ] || rm -f "$SHUNT_AGENTS_DIR/$agent.md"
  rm -f "$SHUNT_AGENTS_DIR/$writer.md"
  shunt_breaker_clear_state "$id"
  echo "shunt: removed '$id'."
}

cmd_reorder() {
  local id="${1:-}" position="${2:-}"
  [ -n "$id" ] && [ -n "$position" ] || shunt_report_error "usage: shunt-models reorder <provider/model> <1-based position>"
  case "$position" in ''|*[!0-9]*) shunt_report_error "position must be a positive integer." ;; esac
  shunt_models_available || shunt_report_error "no models registry at $SHUNT_MODELS_FILE."

  local current
  current=$(cat "$SHUNT_MODELS_FILE")

  if ! echo "$current" | jq -e --arg id "$id" '.models | any(.id == $id)' >/dev/null; then
    shunt_report_error "model '$id' is not in the registry."
  fi

  local updated
  updated=$(echo "$current" | jq --arg id "$id" --argjson pos "$((position - 1))" '
    (.models | map(select(.id == $id))) as $target
    | (.models | map(select(.id != $id))) as $rest
    | .models = ($rest[0:$pos] + $target + $rest[$pos:])
  ')

  shunt_models_write "$updated"
  echo "shunt: moved '$id' to position $position."
}

cmd_activate() {
  local id="${1:-}"
  [ -n "$id" ] || shunt_report_error "usage: shunt-models activate <provider/model>"
  shunt_models_available || shunt_report_error "no models registry at $SHUNT_MODELS_FILE."

  local current
  current=$(cat "$SHUNT_MODELS_FILE")

  if ! echo "$current" | jq -e --arg id "$id" '.models | any(.id == $id)' >/dev/null; then
    shunt_report_error "model '$id' is not in the registry."
  fi

  if echo "$current" | jq -e --arg id "$id" '.models | any(.id == $id and .enabled == false)' >/dev/null; then
    shunt_report_error "model '$id' is disabled. Enable it first: shunt-models enable $id"
  fi

  local updated
  updated=$(echo "$current" | jq --arg id "$id" '.active = $id')
  shunt_models_write "$updated"
  echo "shunt: activated '$id'."
}

# cmd_set_enabled <true|false> <id>
# Backs `enable`/`disable`. Only flips the flag: the model keeps its
# position, agent file and active marker, so re-enabling restores it as-is.
cmd_set_enabled() {
  local value="$1" id="${2:-}"
  local verb="enable"
  [ "$value" = "true" ] || verb="disable"
  [ -n "$id" ] || shunt_report_error "usage: shunt-models $verb <provider/model>"
  shunt_models_available || shunt_report_error "no models registry at $SHUNT_MODELS_FILE."

  local current
  current=$(cat "$SHUNT_MODELS_FILE")

  if ! echo "$current" | jq -e --arg id "$id" '.models | any(.id == $id)' >/dev/null; then
    shunt_report_error "model '$id' is not in the registry."
  fi

  local updated
  updated=$(echo "$current" | jq --arg id "$id" --argjson v "$value" \
    '.models |= map(if .id == $id then .enabled = $v else . end)')
  shunt_models_write "$updated"
  echo "shunt: ${verb}d '$id'."
}

cmd_thinking() {
  local id="${1:-}" state="${2:-}" options="${3:-}"
  [ -n "$id" ] && [ -n "$state" ] || shunt_report_error "usage: shunt-models thinking <provider/model> <on|off> [options-json]"
  case "$state" in
    on|off) ;;
    *) shunt_report_error "thinking state must be 'on' or 'off'." ;;
  esac
  shunt_models_available || shunt_report_error "no models registry at $SHUNT_MODELS_FILE."

  local current
  current=$(cat "$SHUNT_MODELS_FILE")

  if ! echo "$current" | jq -e --arg id "$id" '.models | any(.id == $id)' >/dev/null; then
    shunt_report_error "model '$id' is not in the registry."
  fi

  local updated
  if [ "$state" = "on" ]; then
    local options_json="null"
    if [ -n "$options" ]; then
      echo "$options" | jq -e . >/dev/null 2>&1 || shunt_report_error "thinking options must be valid JSON: $options"
      options_json="$options"
    fi
    updated=$(echo "$current" | jq --arg id "$id" --argjson opts "$options_json" '
      .models |= map(if .id == $id then .thinking = true | .thinking_options = $opts else . end)
    ')
  else
    # Without options-json the stored off options stay as they are. An empty
    # object clears them. `on` never touches them.
    local set_off=false off_options_json="null"
    if [ -n "$options" ]; then
      echo "$options" | jq empty >/dev/null 2>&1 || shunt_report_error "thinking options must be valid JSON: $options"
      echo "$options" | jq -e 'type == "object"' >/dev/null 2>&1 || shunt_report_error "thinking off options must be a JSON object: $options"
      set_off=true
      off_options_json=$(echo "$options" | jq -c 'if length == 0 then null else . end')
    fi
    updated=$(echo "$current" | jq --arg id "$id" --argjson set_off "$set_off" --argjson off "$off_options_json" '
      .models |= map(if .id == $id then
        .thinking = false | .thinking_options = null
        | (if $set_off then .thinking_off_options = $off else . end)
      else . end)
    ')
  fi

  shunt_models_write "$updated"
  shunt_models_materialize_agent "$id"
  echo "shunt: thinking for '$id' set to $state."
}

# cmd_request_body <id> [--role <role>] <json-object|--clear>
# Sets or clears request_body, or role_request_body[<role>] with --role. An
# emptied role_request_body is dropped from the entry.
cmd_request_body() {
  local id="${1:-}" role="" value
  local usage="usage: shunt-models request-body <provider/model> [--role <${SHUNT_MODELS_ROLES[0]}|${SHUNT_MODELS_ROLES[1]}>] <json-object|--clear>"
  [ -n "$id" ] || shunt_report_error "$usage"
  shift
  if [ "${1:-}" = "--role" ]; then
    role="${2:-}"
    [ -n "$role" ] || shunt_report_error "$usage"
    shift 2
  fi
  value="${1:-}"
  [ -n "$value" ] && [ "$#" -eq 1 ] || shunt_report_error "$usage"
  if [ -n "$role" ]; then
    printf '%s\n' "${SHUNT_MODELS_ROLES[@]}" | grep -qxF -- "$role" \
      || shunt_report_error "unknown role '$role' (roles: ${SHUNT_MODELS_ROLES[*]})."
  fi
  local body="null"
  if [ "$value" != "--clear" ]; then
    echo "$value" | jq -e 'type == "object"' >/dev/null 2>&1 \
      || shunt_report_error "request body must be a JSON object: $value"
    body=$(echo "$value" | jq -c .)
  fi
  shunt_models_available || shunt_report_error "no models registry at $SHUNT_MODELS_FILE."
  local current updated
  current=$(cat "$SHUNT_MODELS_FILE")
  echo "$current" | jq -e --arg id "$id" '.models | any(.id == $id)' >/dev/null \
    || shunt_report_error "model '$id' is not in the registry."
  updated=$(echo "$current" | jq --arg id "$id" --arg role "$role" --argjson body "$body" '
    .models |= map(if .id != $id then . elif $role == "" then
        (if $body == null then del(.request_body) else .request_body = $body end)
      else
        (if $body == null then del(.role_request_body[$role]) else .role_request_body[$role] = $body end)
        | (if (.role_request_body // {}) == {} then del(.role_request_body) else . end)
      end)
  ') || shunt_report_error "could not update the registry entry for '$id'."
  shunt_models_write "$updated"
  echo "shunt: request body for '$id'${role:+ (role $role)} $([ "$body" = null ] && echo cleared || echo set)."
}

# cmd_roles <id> <role>[,<role>...]
# Sets the model's `roles` (bulk-read, code-write). Order is kept and
# duplicates dropped. Rewrites the registry, then re-materializes the model's
# agent files so its code-writer agent exists exactly while it has the
# code-write role.
cmd_roles() {
  local id="${1:-}" roles_arg="${2:-}"
  [ -n "$id" ] && [ -n "$roles_arg" ] || shunt_report_error "usage: shunt-models roles <provider/model> <role>[,<role>...] (roles: ${SHUNT_MODELS_ROLES[*]})"

  local roles_json
  roles_json=$(shunt_models_parse_roles "$roles_arg")

  # Deliberately not shunt_models_available: this command is the way to fix a
  # registry that is invalid only because of a bad `roles` value.
  [ -f "$SHUNT_MODELS_FILE" ] || shunt_report_error "no models registry at $SHUNT_MODELS_FILE."
  jq -e '.models | type == "array"' "$SHUNT_MODELS_FILE" >/dev/null 2>&1 \
    || shunt_report_error "$SHUNT_MODELS_FILE is not a valid models registry."

  local current
  current=$(cat "$SHUNT_MODELS_FILE")

  if ! echo "$current" | jq -e --arg id "$id" '.models | any(.id == $id)' >/dev/null; then
    shunt_report_error "model '$id' is not in the registry."
  fi

  local updated
  updated=$(echo "$current" | jq --arg id "$id" --argjson roles "$roles_json" \
    '.models |= map(if .id == $id then .roles = $roles else . end)')
  shunt_models_write "$updated"
  shunt_models_materialize_agent "$id"
  echo "shunt: roles for '$id' set to $(echo "$roles_json" | jq -r 'join(",")')."

  local problem
  problem=$(shunt_models_validate) || echo "shunt: warning, the registry is still invalid: $problem" >&2
}

# Longest context_tokens accepted, in digits (keeps the value exact in jq).
SHUNT_CONTEXT_MAX_DIGITS=12

# shunt_models_store_context <provider/model> <tokens>
# Stores <tokens> as the model's context_tokens through the atomic registry
# write. Like cmd_roles it does not need a valid registry to begin with.
shunt_models_store_context() {
  local id="$1" tokens="$2" current updated
  [[ "$tokens" =~ ^[1-9][0-9]{0,$((SHUNT_CONTEXT_MAX_DIGITS - 1))}$ ]] \
    || shunt_report_error "tokens must be a positive integer of at most $SHUNT_CONTEXT_MAX_DIGITS digits."
  [ -f "$SHUNT_MODELS_FILE" ] || shunt_report_error "no models registry at $SHUNT_MODELS_FILE."
  jq -e '.models | type == "array"' "$SHUNT_MODELS_FILE" >/dev/null 2>&1 \
    || shunt_report_error "$SHUNT_MODELS_FILE is not a valid models registry."
  current=$(cat "$SHUNT_MODELS_FILE")
  echo "$current" | jq -e --arg id "$id" '.models | any(.id == $id)' >/dev/null \
    || shunt_report_error "model '$id' is not in the registry."
  updated=$(echo "$current" | jq --arg id "$id" --argjson t "$tokens" \
    '.models |= map(if .id == $id then .context_tokens = $t else . end)')
  shunt_models_write "$updated"
  echo "shunt: context_tokens for '$id' set to $tokens."
}

# set-context <provider/model> <tokens>
cmd_set_context() {
  local id="${1:-}" tokens="${2:-}"
  [ -n "$id" ] && [ -n "$tokens" ] || shunt_report_error "usage: shunt-models set-context <provider/model> <tokens>"
  shunt_models_store_context "$id" "$tokens"
}

# detect-context <provider/model> [--write]
# Asks the provider for the model's context window. Prints it, and with --write
# stores it. Nothing is ever written when the provider does not report one.
cmd_detect_context() {
  local id="${1:-}" write="${2:-}" tokens
  [ -n "$id" ] && { [ -z "$write" ] || [ "$write" = --write ]; } \
    || shunt_report_error "usage: shunt-models detect-context <provider/model> [--write]"
  tokens=$(shunt_models_detect_context "$id") || tokens=""
  [ -n "$tokens" ] || shunt_report_error "could not detect the context window of '$id' from its provider. Enter it yourself: shunt-models set-context $id <tokens>"
  if [ "$write" = --write ]; then
    shunt_models_store_context "$id" "$tokens"
  fi
  echo "$tokens"
}

cmd_list() {
  shunt_models_available || { shunt_models_unavailable_notice; return 0; }
  local active
  active=$(jq -r '.active // empty' "$SHUNT_MODELS_FILE")
  jq -r '.models[].id' "$SHUNT_MODELS_FILE" | while IFS= read -r id; do
    if [ "$id" = "$active" ]; then
      echo "$id (active)"
    else
      echo "$id"
    fi
  done
}

cmd_status() {
  shunt_models_available || { shunt_models_unavailable_notice; return 0; }
  if [ "$(jq '.models | length' "$SHUNT_MODELS_FILE")" -eq 0 ]; then
    echo "shunt: no delegate models configured (large reads are not redirected)."
    return 0
  fi
  jq -r --argjson all_roles "$SHUNT_MODELS_ROLES_JSON" '
    .active as $active
    | .models[]
    | "\(.id)\t\(.agent)\t" + (if .enabled == false then "disabled" else "enabled" end)
      + "\tthinking=\(.thinking)\tthinking_off=\(if .thinking_off_options == null then "none" else "set" end)\troles=\((.roles // $all_roles) | join(","))\t"
      + (if .id != $active then ""
         elif .enabled == false then "active (skipped, disabled)"
         else "active" end)
  ' "$SHUNT_MODELS_FILE"

  # Which model the next bulk-read call tries first: the active one if it is
  # enabled and has the role, otherwise the first such model in registry order.
  local candidates first
  candidates=$(shunt_models_candidates bulk-read)
  first="${candidates%%$'\n'*}"
  if [ -n "$first" ]; then
    echo "shunt: first choice: $first"
  elif jq -e '.models | any(.enabled != false)' "$SHUNT_MODELS_FILE" >/dev/null; then
    echo "shunt: no enabled model has the bulk-read role (large reads are not redirected)."
  else
    echo "shunt: no enabled models (large reads are not redirected)."
  fi

  # The same for code-write, which uses the same order over the models that
  # have that role. Quiet: the lookup above already warned about an unknown
  # active model.
  candidates=$(shunt_models_candidates code-write quiet)
  first="${candidates%%$'\n'*}"
  if [ -n "$first" ]; then
    echo "shunt: code-write first choice: $first"
  else
    echo "shunt: no enabled model has the code-write role (code-write is unavailable)."
  fi

  # code-write keeps its own failure counter per model, apart from bulk-read's.
  local id
  jq -r --argjson all_roles "$SHUNT_MODELS_ROLES_JSON" \
    '.models[] | select((.roles // $all_roles) | index("code-write") != null) | .id' \
    "$SHUNT_MODELS_FILE" | while IFS= read -r id; do
    echo "shunt: code-write breaker $id: $(shunt_breaker_status "$(shunt_breaker_key "$id" code-write)")"
  done
}

cmd_sync() {
  shunt_models_available || shunt_report_error "no models registry at $SHUNT_MODELS_FILE."
  jq -r '.models[].id' "$SHUNT_MODELS_FILE" | while IFS= read -r id; do
    shunt_models_materialize_agent "$id"
    echo "shunt: re-materialized '$id'."
  done
}

# shunt_read_key
# Prints one key line read from the tty without echo (prompt on stderr), or
# from stdin when it is not a tty (tests, pipes).
shunt_read_key() {
  local key
  if [ -t 0 ]; then
    IFS= read -r -s -p "API key (input hidden): " key
    echo >&2
  else
    IFS= read -r key || true
  fi
  printf '%s\n' "$key"
}

# cmd_key set|status <provider>
cmd_key() {
  local action="${1:-}" provider="${2:-}"
  [ -n "$provider" ] || shunt_report_error "usage: shunt-models key <set|status> <provider>"
  [ -f "$SHUNT_PROVIDERS_FILE" ] && jq -e --arg p "$provider" '.providers[$p]' "$SHUNT_PROVIDERS_FILE" >/dev/null 2>&1 \
    || shunt_report_error "provider '$provider' is not in $SHUNT_PROVIDERS_FILE."
  local type
  type=$(shunt_provider_key_type "$provider") || exit 1
  case "$action" in
    set) cmd_key_set "$provider" "$type" ;;
    status)
      if [ "$type" = none ]; then
        echo "shunt: provider '$provider': yes (type none, no key needed)"
      elif shunt_provider_key_resolve "$provider" >/dev/null 2>&1; then
        echo "shunt: provider '$provider': yes (type $type)"
      else
        echo "shunt: provider '$provider': no (type $type)"
      fi ;;
    *) shunt_report_error "usage: shunt-models key <set|status> <provider>" ;;
  esac
}

cmd_key_set() {
  local provider="$1" type="$2" key
  case "$type" in
    env) shunt_report_error "provider '$provider' uses an env key: export the variable named in its key.ref instead." ;;
    none) shunt_report_error "provider '$provider' has key type none, there is no key to set." ;;
    keyring) [ -n "$(shunt_keyring_backend)" ] || shunt_report_error "no keyring backend found (secret-tool, security, kwallet-query). Use an env key type instead." ;;
  esac
  key=$(shunt_read_key)
  [ -n "$key" ] || shunt_report_error "empty key, nothing stored."
  if [ "$type" = keyring ]; then
    printf '%s\n' "$key" | shunt_keyring_store "$provider" || exit 1
  else
    printf '%s\n' "$key" | shunt_provider_plaintext_store "$provider" || exit 1
    shunt_provider_plaintext_warning >&2
  fi
  echo "shunt: key stored for '$provider' (type $type)."
}

subcommand="${1:-}"
[ -n "$subcommand" ] || shunt_report_error "usage: shunt-models <list|status|add|remove|reorder|activate|enable|disable|thinking|request-body|roles|set-context|detect-context|sync|key> [args...]"
shift

case "$subcommand" in
  add) cmd_add "$@" ;;
  remove) cmd_remove "$@" ;;
  reorder) cmd_reorder "$@" ;;
  activate) cmd_activate "$@" ;;
  enable) cmd_set_enabled true "$@" ;;
  disable) cmd_set_enabled false "$@" ;;
  thinking) cmd_thinking "$@" ;;
  request-body) cmd_request_body "$@" ;;
  roles) cmd_roles "$@" ;;
  set-context) cmd_set_context "$@" ;;
  detect-context) cmd_detect_context "$@" ;;
  list) cmd_list "$@" ;;
  status) cmd_status "$@" ;;
  sync) cmd_sync "$@" ;;
  key) cmd_key "$@" ;;
  *) shunt_report_error "unknown subcommand: $subcommand" ;;
esac
