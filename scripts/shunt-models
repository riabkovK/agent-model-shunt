#!/bin/bash
# Write side of the shunt-owned delegate model registry
# (~/.config/agent-model-shunt/models.json). Adds/removes/reorders models,
# picks the active one, and materializes each model's OpenCode agent file
# once at edit time. Driven by the /model-config skill; never hand-edit
# models.json directly.
#
#
# Usage:
#   shunt-models list
#   shunt-models status
#   shunt-models dashboard   (everything /model-config shows, one call, see py/shunt/dashboard.py)
#   shunt-models add <provider/model> [<role>[,<role>...]]
#   shunt-models remove <provider/model>
#   shunt-models reorder <provider/model> <1-based position>
#   shunt-models activate <provider/model>
#   shunt-models thinking <provider/model> <on|off> [--role <bulk-read|code-write>] [options-json]
#     on: options-json holds the provider's reasoning options (flat object).
#     off: options-json (a flat object) sets explicit off options, e.g.
#          '{"reasoningEffort":"none"}', rendered into the agent files while
#          thinking is off. Omitted: stored off options stay. '{}' clears them.
#     --role: sets only role_thinking[role] (the model default and the other role stay);
#          options-json then goes to the on or off options without touching the other.
#   shunt-models thinking <provider/model> --role <bulk-read|code-write> --clear
#     Removes that role's override (the field goes when empty).
#   shunt-models request-body <provider/model> [--role <bulk-read|code-write>] <json-object|--clear>
#     Sets or clears the model's request_body (extra fields of every HTTP request),
#     or with --role only that role's role_request_body entry, merged on top of it.
#   shunt-models roles <provider/model> <role>[,<role>...]
#   shunt-models set-context <provider/model> <tokens>
#   shunt-models detect-context <provider/model> [--write]
#     Asks the provider for the context window (never guessed). --write stores it.
#   shunt-models oversize-policy <provider/model> <map_reduce|fail|--clear>
#     set-context, detect-context --write and oversize-policy reset the model's breaker.
#   shunt-models sync
#   shunt-models provider set <name> [--transport http|opencode] [--base-url <url>]
#                [--key keyring|plaintext|none|env:<VARNAME>] [--healthcheck on|off]
#     Creates or updates a providers.json entry, keeping fields not given. Never
#     takes a key value: store it with `key set`. A new entry gets healthcheck on
#     unless --healthcheck off is given, an existing one keeps its value.
#   shunt-models provider list           (name, transport, base_url, key type)
#   shunt-models key set <provider>      (hidden prompt, or one line on piped stdin)
#   shunt-models key status <provider>   (yes/no and key type, never the value)
#   shunt-models --migrate-from-opencode [--apply [--yes]] [--key-storage keyring|env|plaintext|skip]
#     Moves the registry's providers from the OpenCode config to the HTTP transport.
#     Dry run by default (prints the plan). --apply backs up models.json and
#     providers.json, then writes. Without a tty --apply needs --yes (the
#     caller confirms the dry-run plan first); --yes skips the y/N prompt. A literal apiKey is copied only to the chosen
#     storage and never shown.

# One process: scripts/py/shunt/models_cli.py runs every subcommand. This launcher
# only starts it, with no other process in between. The arguments go through raw.

# No child may source a caller's startup file (it could turn on xtrace or log a key).
unset BASH_ENV ENV

case "${BASH_SOURCE[0]}" in
  */*) SCRIPT_DIR="${BASH_SOURCE[0]%/*}" ;;
  *) SCRIPT_DIR=. ;;
esac
# shellcheck source=lib/py.sh
source "$SCRIPT_DIR/lib/py.sh"

exec "${SHUNT_PYTHON:-python3}" -I -B "$SHUNT_PY_MAIN" shunt-models -- "$@"
